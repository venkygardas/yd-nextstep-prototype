# Set ONE key. Free options first (no credit card needed).
# With no key at all, the app still runs on its rule-based fallback.

# Free: https://console.groq.com/keys
GROQ_API_KEY=

# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid options
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the model name for whichever provider is active
# AI_MODEL=
